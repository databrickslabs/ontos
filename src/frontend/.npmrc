# @hookform/resolvers@5 declares an optional peer on ajv-formats@^2, but this app
# depends on ajv-formats@^3 directly (JSON-schema validation) and uses zod — not
# ajv — with react-hook-form, so that optional peer is unused. npm 7+ strict peer
# resolution otherwise fails the Databricks Apps build with ERESOLVE. Accept the
# optional-peer mismatch for every npm invocation (ci, install, local + CI alike).
legacy-peer-deps=true
